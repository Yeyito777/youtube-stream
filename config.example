# Copy to ~/.config/youtube-stream/config and chmod 600 it.
# The youtube-stream command can also create this file after prompting for a key.

# Either set a stream key and use the default YouTube RTMP endpoint...
YOUTUBE_STREAM_KEY=
YOUTUBE_STREAM_RTMP_BASE=rtmp://a.rtmp.youtube.com/live2

# ...or set a full stream URL instead:
# YOUTUBE_STREAM_URL=rtmp://a.rtmp.youtube.com/live2/xxxx-xxxx-xxxx-xxxx-xxxx

# Optional: pin a specific existing broadcast/video if the API should not choose
# the first non-complete Live broadcast automatically.
# YOUTUBE_STREAM_BROADCAST_ID=VIDEO_ID

# YouTube Live Stream CDN profile. The API helper creates/reuses a matching
# 1080p60 stream-key resource and returns that ingest URL to the encoder.
YOUTUBE_STREAM_CDN_RESOLUTION=1080p
YOUTUBE_STREAM_CDN_FRAME_RATE=60fps
YOUTUBE_STREAM_CREATE_LIVE_STREAM=yes
# YOUTUBE_STREAM_LIVE_STREAM_TITLE='youtube-stream 1080p60'
# YOUTUBE_STREAM_INGEST_PROTOCOL=rtmp
# YOUTUBE_STREAM_LIVE_STREAM_ID=STREAM_RESOURCE_ID

# Capture / encoding
YOUTUBE_STREAM_FPS=60
YOUTUBE_STREAM_VIDEO_CODEC=h264
YOUTUBE_STREAM_VIDEO_BITRATE_KBPS=12000
# C stream manager supports the known-good direct gpu-screen-recorder RTMP path.
YOUTUBE_STREAM_CAPTURE_BACKEND=gsr-direct-rtmp
# gpu-screen-recorder direct RTMP settings:
YOUTUBE_STREAM_GSR_TUNE=quality
# Best-effort for GPU backends only: keeps AMD GPU clocks from idling during capture; set auto/off to disable.
YOUTUBE_STREAM_GPU_PERF=high
YOUTUBE_STREAM_ENCODER=gpu
YOUTUBE_STREAM_FALLBACK_CPU_ENCODING=no
YOUTUBE_STREAM_KEYINT=2

# Audio. gpu-screen-recorder captures default mic + default system audio into one
# AAC stream. The TUI adjusts only these stream source-output volumes.
YOUTUBE_STREAM_MIC_SOURCE=default_input
YOUTUBE_STREAM_SYSTEM_SOURCE=default_output
YOUTUBE_STREAM_MIC_GAIN=10.5
YOUTUBE_STREAM_SYSTEM_GAIN=0.675
YOUTUBE_STREAM_AUDIO_BITRATE=192k

# Browser behavior. vimbrowser is only used to open the public watch page after
# the YouTube Data API metadata update succeeds.
YOUTUBE_STREAM_BROWSER_WAIT=5

# Stream-manager TUI. Enabled by default on interactive terminals. Use --no-tui
# or YOUTUBE_STREAM_TUI=0 to keep raw encoder logs in the terminal.
YOUTUBE_STREAM_TUI=1
YOUTUBE_STREAM_TUI_STATUS_INTERVAL=15

# Required to stream. You can set these here, but per-stream CLI args are usually better:
#   youtube-stream -t 'Title' -d 'Description' -p /path/to/thumbnail.png
# YOUTUBE_STREAM_TITLE='My stream title'
# YOUTUBE_STREAM_DESCRIPTION='My stream description'
# YOUTUBE_STREAM_THUMBNAIL=/path/to/thumbnail.png
# Optional; if unset, the current broadcast privacy is left unchanged.
# YOUTUBE_STREAM_PRIVACY=public

# Optional helper overrides.
# VIMBROWSER_CLI=/home/yeyito/Workspace/exocortex/external-tools/vimbrowser-cli/bin/vimbrowser-cli
# YOUTUBE_STREAM_API_HELPER=/home/yeyito/.local/lib/youtube-stream/youtube-stream-api
