#!/usr/bin/env python3
import argparse
import json
import mimetypes
import os
import pathlib
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
import uuid

CONFIG_DIR = pathlib.Path(os.environ.get("XDG_CONFIG_HOME", pathlib.Path.home() / ".config")) / "youtube-stream"
CLIENT_SECRET_FILE = CONFIG_DIR / "client_secret.json"
TOKEN_FILE = CONFIG_DIR / "oauth-token.json"
YOUTUBE_API = "https://www.googleapis.com/youtube/v3/"
YOUTUBE_UPLOAD_API = "https://www.googleapis.com/upload/youtube/v3/"


def die(msg, status=1):
    print(f"youtube-stream-api: error: {msg}", file=sys.stderr)
    raise SystemExit(status)


def read_json(path):
    try:
        return json.loads(path.read_text())
    except FileNotFoundError:
        die(f"missing {path}; create an OAuth desktop client and authorize it first")
    except json.JSONDecodeError as e:
        die(f"invalid JSON in {path}: {e}")


def atomic_write_json(path, data):
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n")
    os.chmod(tmp, 0o600)
    tmp.replace(path)
    os.chmod(path, 0o600)


def load_oauth_config():
    token = read_json(TOKEN_FILE)
    client = {}
    if CLIENT_SECRET_FILE.exists():
        raw = read_json(CLIENT_SECRET_FILE)
        client = raw.get("installed") or raw.get("web") or raw
    for key in ("client_id", "client_secret"):
        token.setdefault(key, client.get(key))
    if not token.get("client_id") or not token.get("client_secret"):
        die(f"{TOKEN_FILE} does not contain OAuth client_id/client_secret and {CLIENT_SECRET_FILE} is missing them")
    if not token.get("refresh_token"):
        die(f"{TOKEN_FILE} does not contain a refresh_token; run OAuth setup again")
    return token


def http_json(method, url, access_token=None, body=None, headers=None, raw_data=None):
    req_headers = dict(headers or {})
    data = raw_data
    if access_token:
        req_headers["Authorization"] = f"Bearer {access_token}"
    if body is not None:
        data = json.dumps(body).encode("utf-8")
        req_headers.setdefault("Content-Type", "application/json; charset=UTF-8")
    req = urllib.request.Request(url, data=data, headers=req_headers, method=method)
    try:
        with urllib.request.urlopen(req) as resp:
            payload = resp.read()
    except urllib.error.HTTPError as e:
        detail = e.read().decode("utf-8", errors="replace")
        try:
            parsed = json.loads(detail)
            message = parsed.get("error", {}).get("message") or detail
        except Exception:
            message = detail
        die(f"HTTP {e.code} from {url}: {message}")
    if not payload:
        return {}
    return json.loads(payload)


def access_token():
    token = load_oauth_config()
    now = int(time.time())
    if token.get("access_token") and int(token.get("expires_at", 0)) > now + 120:
        return token["access_token"]

    body = urllib.parse.urlencode({
        "client_id": token["client_id"],
        "client_secret": token["client_secret"],
        "refresh_token": token["refresh_token"],
        "grant_type": "refresh_token",
    }).encode("utf-8")
    refreshed = http_json(
        "POST",
        "https://oauth2.googleapis.com/token",
        raw_data=body,
        headers={"Content-Type": "application/x-www-form-urlencoded"},
    )
    token.update(refreshed)
    token["expires_at"] = now + int(refreshed.get("expires_in", 3600))
    atomic_write_json(TOKEN_FILE, token)
    return token["access_token"]


def yt_get(path, params, token):
    return http_json("GET", YOUTUBE_API + path + "?" + urllib.parse.urlencode(params), token)


def yt_put(path, params, token, body):
    return http_json("PUT", YOUTUBE_API + path + "?" + urllib.parse.urlencode(params), token, body=body)


def yt_post(path, params, token, body):
    return http_json("POST", YOUTUBE_API + path + "?" + urllib.parse.urlencode(params), token, body=body)


def yt_post_upload(path, params, token, file_path):
    path_obj = pathlib.Path(file_path)
    mime = mimetypes.guess_type(path_obj.name)[0] or "application/octet-stream"
    boundary = "===============%s==" % uuid.uuid4().hex
    data = b"".join([
        f"--{boundary}\r\nContent-Type: application/json; charset=UTF-8\r\n\r\n{{}}\r\n".encode(),
        f"--{boundary}\r\nContent-Type: {mime}\r\n\r\n".encode(),
        path_obj.read_bytes(),
        b"\r\n",
        f"--{boundary}--\r\n".encode(),
    ])
    return http_json(
        "POST",
        YOUTUBE_UPLOAD_API + path + "?" + urllib.parse.urlencode(params),
        token,
        raw_data=data,
        headers={"Content-Type": f"multipart/related; boundary={boundary}"},
    )


def list_broadcasts(token):
    return yt_get("liveBroadcasts", {
        "part": "id,snippet,status,contentDetails",
        "mine": "true",
        "maxResults": "25",
    }, token).get("items", [])


def desired_stream_profile():
    resolution = os.environ.get("YOUTUBE_STREAM_CDN_RESOLUTION", "1080p")
    frame_rate = os.environ.get("YOUTUBE_STREAM_CDN_FRAME_RATE") or os.environ.get("YOUTUBE_STREAM_CDN_FRAMERATE", "60fps")
    title = os.environ.get("YOUTUBE_STREAM_LIVE_STREAM_TITLE", f"youtube-stream {resolution}{frame_rate.replace('fps', '')}")
    protocol = os.environ.get("YOUTUBE_STREAM_INGEST_PROTOCOL", "rtmp").lower()
    if protocol not in ("rtmp", "rtmps"):
        die("YOUTUBE_STREAM_INGEST_PROTOCOL must be rtmp or rtmps")
    return resolution, frame_rate, title, protocol


def stream_ingestion_url(stream, protocol="rtmp"):
    info = stream.get("cdn", {}).get("ingestionInfo", {})
    stream_name = info.get("streamName")
    if not stream_name:
        die(f"live stream {stream.get('id')} has no ingestion streamName")
    address_key = "rtmpsIngestionAddress" if protocol == "rtmps" else "ingestionAddress"
    address = info.get(address_key) or info.get("ingestionAddress")
    if not address:
        die(f"live stream {stream.get('id')} has no ingestion address")
    return f"{address.rstrip('/')}/{stream_name}"


def choose_live_stream(token):
    configured = os.environ.get("YOUTUBE_STREAM_ID") or os.environ.get("YOUTUBE_STREAM_LIVE_STREAM_ID")
    resolution, frame_rate, title, _ = desired_stream_profile()
    if configured:
        resp = yt_get("liveStreams", {"part": "id,snippet,cdn,status", "id": configured}, token)
        items = resp.get("items", [])
        if not items:
            die(f"configured live stream id not found in authorized channel: {configured}")
        return items[0]

    resp = yt_get("liveStreams", {"part": "id,snippet,cdn,status", "mine": "true", "maxResults": "50"}, token)
    items = resp.get("items", [])

    matching = [
        item for item in items
        if item.get("cdn", {}).get("resolution") == resolution
        and item.get("cdn", {}).get("frameRate") == frame_rate
    ]

    if not matching:
        create = os.environ.get("YOUTUBE_STREAM_CREATE_LIVE_STREAM", "yes").lower()
        if create in ("", "0", "no", "false", "off"):
            die(f"no YouTube Live stream key resource found for {resolution}/{frame_rate}; create one or unset YOUTUBE_STREAM_CREATE_LIVE_STREAM=off")
        body = {
            "snippet": {
                "title": title,
                "description": f"Reusable stream key for youtube-stream {resolution} {frame_rate}",
            },
            "cdn": {
                "ingestionType": "rtmp",
                "resolution": resolution,
                "frameRate": frame_rate,
            },
        }
        return yt_post("liveStreams", {"part": "snippet,cdn"}, token, body)

    def score(item):
        item_title = item.get("snippet", {}).get("title", "")
        status = item.get("status", {}).get("streamStatus", "")
        return (
            0 if item_title == title else 1,
            0 if status in ("inactive", "ready", "active") else 1,
            item_title,
        )

    matching.sort(key=score)
    return matching[0]


def create_broadcast(token, title, description, privacy, stream):
    scheduled = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(time.time() + 15))
    body = {
        "snippet": {
            "title": title,
            "description": description,
            "scheduledStartTime": scheduled,
        },
        "status": {
            "privacyStatus": privacy,
            "selfDeclaredMadeForKids": False,
        },
        "contentDetails": {
            "enableAutoStart": True,
            "enableAutoStop": True,
            "enableDvr": True,
            "latencyPreference": os.environ.get("YOUTUBE_STREAM_LATENCY", "low"),
            "monitorStream": {"enableMonitorStream": True},
        },
    }
    broadcast = yt_post("liveBroadcasts", {"part": "snippet,status,contentDetails"}, token, body)
    return yt_post("liveBroadcasts/bind", {
        "id": broadcast["id"],
        "part": "id,snippet,status,contentDetails",
        "streamId": stream["id"],
    }, token, {})


def ensure_broadcast_bound(token, broadcast, stream):
    video_id = broadcast["id"]
    current = broadcast.get("contentDetails", {}).get("boundStreamId")
    if current == stream["id"]:
        return broadcast
    status = broadcast.get("status", {}).get("lifeCycleStatus")
    if status in ("live", "testing"):
        die(f"broadcast {video_id} is already {status} but is not bound to the requested {stream['cdn']['resolution']}/{stream['cdn']['frameRate']} stream")
    return yt_post("liveBroadcasts/bind", {
        "id": video_id,
        "part": "id,snippet,status,contentDetails",
        "streamId": stream["id"],
    }, token, {})


def choose_broadcast(items, requested_id=None):
    if requested_id:
        for item in items:
            if item.get("id") == requested_id:
                return item
        die(f"configured broadcast/video id not found in authorized channel: {requested_id}")

    rank = {
        "live": 0,
        "testing": 1,
        "ready": 2,
        "created": 3,
        "revoked": 8,
        "complete": 9,
    }
    usable = [item for item in items if item.get("status", {}).get("lifeCycleStatus") != "complete"]
    if not usable:
        return None
    usable.sort(key=lambda item: (
        rank.get(item.get("status", {}).get("lifeCycleStatus"), 5),
        item.get("snippet", {}).get("scheduledStartTime", ""),
        item.get("snippet", {}).get("publishedAt", ""),
    ))
    return usable[0]


def update(args):
    token = access_token()
    privacy = args.privacy or "private"
    stream = choose_live_stream(token)
    _, _, _, protocol = desired_stream_profile()
    requested_id = args.broadcast_id or os.environ.get("YOUTUBE_STREAM_BROADCAST_ID") or os.environ.get("YOUTUBE_STREAM_VIDEO_ID")
    item = choose_broadcast(list_broadcasts(token), requested_id)
    created = False
    if item is None:
        if requested_id:
            die(f"configured broadcast/video id is complete and cannot be reused: {requested_id}")
        item = create_broadcast(token, args.title, args.description, privacy, stream)
        created = True
    else:
        item = ensure_broadcast_bound(token, item, stream)

    video_id = item["id"]

    parts = ["snippet"]
    snippet = dict(item.get("snippet", {}))
    snippet["title"] = args.title
    snippet["description"] = args.description
    body = {
        "id": video_id,
        "snippet": snippet,
    }
    if args.privacy or created:
        parts.append("status")
        body["status"] = {"privacyStatus": privacy, "selfDeclaredMadeForKids": False}

    updated = yt_put("liveBroadcasts", {"part": ",".join(parts)}, token, body)
    thumb_resp = yt_post_upload("thumbnails/set", {"videoId": video_id, "uploadType": "multipart"}, token, args.thumbnail)

    out = {
        "broadcast_id": video_id,
        "video_id": video_id,
        "watch_url": f"https://www.youtube.com/watch?v={video_id}",
        "stream_id": stream.get("id"),
        "stream_resolution": stream.get("cdn", {}).get("resolution"),
        "stream_frame_rate": stream.get("cdn", {}).get("frameRate"),
        "stream_url": stream_ingestion_url(stream, protocol),
        "title": updated.get("snippet", {}).get("title", args.title),
        "description": updated.get("snippet", {}).get("description", args.description),
        "life_cycle_status": updated.get("status", item.get("status", {})).get("lifeCycleStatus"),
        "privacy_status": updated.get("status", item.get("status", {})).get("privacyStatus"),
        "thumbnail_updated": bool(thumb_resp.get("items")),
        "created_broadcast": created,
    }
    print(json.dumps(out, ensure_ascii=False))


def complete(args):
    token = access_token()
    resp = yt_get("liveBroadcasts", {
        "part": "id,status",
        "id": args.broadcast_id,
    }, token)
    items = resp.get("items", [])
    if not items:
        die(f"broadcast not found: {args.broadcast_id}")
    current_status = items[0].get("status", {}).get("lifeCycleStatus")
    if current_status in ("complete", "created", "ready"):
        print(json.dumps({
            "broadcast_id": args.broadcast_id,
            "life_cycle_status": current_status,
            "transitioned": False,
        }, ensure_ascii=False))
        return

    result = yt_post("liveBroadcasts/transition", {
        "id": args.broadcast_id,
        "broadcastStatus": "complete",
        "part": "id,status",
    }, token, {})
    print(json.dumps({
        "broadcast_id": result.get("id", args.broadcast_id),
        "life_cycle_status": result.get("status", {}).get("lifeCycleStatus"),
        "transitioned": True,
    }, ensure_ascii=False))


def status(args):
    token = access_token()
    broadcast_resp = yt_get("liveBroadcasts", {
        "part": "id,snippet,status",
        "id": args.broadcast_id,
    }, token)
    broadcast_items = broadcast_resp.get("items", [])
    if not broadcast_items:
        die(f"broadcast not found: {args.broadcast_id}")

    video_resp = yt_get("videos", {
        "part": "id,snippet,status,liveStreamingDetails,statistics",
        "id": args.broadcast_id,
    }, token)
    video_items = video_resp.get("items", [])
    video = video_items[0] if video_items else {}
    broadcast = broadcast_items[0]
    details = video.get("liveStreamingDetails", {})
    stats = video.get("statistics", {})
    print(json.dumps({
        "broadcast_id": broadcast.get("id", args.broadcast_id),
        "title": broadcast.get("snippet", {}).get("title") or video.get("snippet", {}).get("title"),
        "life_cycle_status": broadcast.get("status", {}).get("lifeCycleStatus"),
        "privacy_status": broadcast.get("status", {}).get("privacyStatus") or video.get("status", {}).get("privacyStatus"),
        "actual_start_time": details.get("actualStartTime"),
        "actual_end_time": details.get("actualEndTime"),
        "concurrent_viewers": details.get("concurrentViewers"),
        "view_count": stats.get("viewCount"),
        "watch_url": f"https://www.youtube.com/watch?v={broadcast.get('id', args.broadcast_id)}",
    }, ensure_ascii=False))


def main():
    parser = argparse.ArgumentParser(prog="youtube-stream-api")
    sub = parser.add_subparsers(dest="command", required=True)

    up = sub.add_parser("update", help="update title/description/thumbnail on the current YouTube Live broadcast")
    up.add_argument("--title", required=True)
    up.add_argument("--description", required=True)
    up.add_argument("--thumbnail", required=True)
    up.add_argument("--privacy", choices=["public", "unlisted", "private"])
    up.add_argument("--broadcast-id")
    up.set_defaults(func=update)

    done = sub.add_parser("complete", help="transition a YouTube Live broadcast to complete")
    done.add_argument("--broadcast-id", required=True)
    done.set_defaults(func=complete)

    st = sub.add_parser("status", help="show status/viewer info for a YouTube Live broadcast")
    st.add_argument("--broadcast-id", required=True)
    st.set_defaults(func=status)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
